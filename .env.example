# Database configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@db:5432/campus_launchpad

# Cache and Queue configuration
REDIS_URL=redis://cache:6379/0

# Security & Authentication
JWT_SECRET_KEY=super_secret_jwt_signing_key_change_me_in_production
JWT_REFRESH_SECRET_KEY=super_secret_refresh_signing_key_change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# TOTP Security Settings (For Admin accounts)
TOTP_ISSUER=CampusLaunchpadDev

# CORS configuration (comma separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Storage Configuration (local or s3)
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_PATH=./uploads
FILE_STORAGE_BUCKET=campus-launchpad-uploads

# NextJS public endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Integrations
# Real secrets should only be set in .env (never committed)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# AI Service Configuration
AI_PROVIDER_KEY=your_gemini_or_openai_api_key_here
AI_MODEL_NAME=gemini-1.5-flash
